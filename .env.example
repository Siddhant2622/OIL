# ============================================================
# SIF Sentinel — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — SERVER ONLY
GEMINI_API_KEY=

# Resend email — SERVER ONLY
RESEND_API_KEY=

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# From address for Resend emails
RESEND_FROM_EMAIL=alerts@sif-sentinel.com

# ============================================================
# WhatsApp Bot & Alerts — SERVER ONLY
# Choose Option A (Twilio Sandbox - easiest) OR Option B (Meta Cloud API)
# ============================================================
# Option A: Twilio WhatsApp (Free Sandbox: join <code> to +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API (Graph API v18.0)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=sif-sentinel-verify

# ============================================================
# Setup Instructions
# ============================================================
#
# 1. SUPABASE
#    - Create project at https://supabase.com
#    - Copy URL and anon key from Project Settings > API
#    - Copy service role key from Project Settings > API (keep secret)
#    - Enable Google OAuth under Authentication > Providers
#
# 2. GOOGLE OAUTH
#    - Go to https://console.cloud.google.com
#    - Create OAuth 2.0 credentials (Web application)
#    - Authorized redirect URI: https://<project>.supabase.co/auth/v1/callback
#    - Add Client ID + Secret to Supabase Auth > Google provider
#
# 3. GEMINI
#    - Get API key at https://aistudio.google.com/apikey
#
# 4. RESEND
#    - Get API key at https://resend.com
#    - Verify your sending domain
#
# 5. WHATSAPP BOT (Choose one):
#    - Twilio: Create free account at https://twilio.com -> Messaging -> Try WhatsApp.
#      Copy Account SID & Auth Token. Webhook URL: https://<your-domain>/api/whatsapp/webhook
#    - Meta: Go to https://developers.facebook.com -> WhatsApp -> API Setup.
#      Copy Access Token & Phone Number ID. Webhook: https://<your-domain>/api/whatsapp/webhook
